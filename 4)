class Libro:
    def __init__(self, titulo, autor, anio_publicacion):
        """Inicializa los datos del libro."""
        self.titulo = titulo
        self.autor = autor
        self.anio_publicacion = anio_publicacion

    def descripcion(self):
        """Devuelve una descripción del libro."""
        return f"'{self.titulo}' de {self.autor}, publicado en {self.anio_publicacion}"

    def es_clasico(self):
        """Verifica si el libro tiene más de 50 años."""
        anio_actual = 2026
        return (anio_actual - self.anio_publicacion) > 50


# Ejemplo de uso
if __name__ == "__main__":
    libro1 = Libro("Cien años de soledad", "Gabriel García Márquez", 1967)

    print(libro1.descripcion())

    if libro1.es_clasico():
        print("Es un clásico.")
    else:
        print("No es un clásico.")
