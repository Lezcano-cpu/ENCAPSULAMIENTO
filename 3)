class CuentaBancaria:
    def __init__(self, titular, saldo, numero_cuenta):
        """Inicializa los datos de la cuenta bancaria."""
        self.titular = titular
        self.saldo = saldo
        self.numero_cuenta = numero_cuenta

    def depositar(self, monto):
        """Deposita dinero en la cuenta."""
        if monto > 0:
            self.saldo += monto
            print(f"Depósito exitoso. Nuevo saldo: ${self.saldo}")
        else:
            print("El monto a depositar debe ser mayor que 0.")

    def retirar(self, monto):
        """Retira dinero de la cuenta si hay saldo suficiente."""
        if monto <= 0:
            print("El monto a retirar debe ser mayor que 0.")
        elif monto > self.saldo:
            print("Fondos insuficientes. No se puede retirar.")
        else:
            self.saldo -= monto
            print(f"Retiro exitoso. Nuevo saldo: ${self.saldo}")

    def mostrar_info(self):
        """Muestra la información de la cuenta."""
        print(f"Titular: {self.titular}")
        print(f"Número de cuenta: {self.numero_cuenta}")
        print(f"Saldo: ${self.saldo}")


# Ejemplo de uso
if __name__ == "__main__":
    cuenta1 = CuentaBancaria("Juan Pérez", 1000, "12345678")

    cuenta1.mostrar_info()

    cuenta1.depositar(500)
    cuenta1.retirar(300)
    cuenta1.retirar(1500)  # intento con saldo insuficiente

    print("\nEstado final de la cuenta:")
    cuenta1.mostrar_info()
